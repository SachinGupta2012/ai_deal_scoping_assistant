# Backend example — copy to .env and fill real secrets (never commit .env)
# AI modes:
#   Demo/test: USE_MOCK_AI=true, AI_PROVIDER=mock
#   Free live chain: USE_MOCK_AI=false, AI_PROVIDER=live_chain
#   Single provider first: USE_MOCK_AI=false, AI_PROVIDER=cloudflare|openrouter|groq|google
ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DB_HOST=
DB_PORT=12279
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
USE_MOCK_AI=true
AI_PROVIDER=mock
AI_PROVIDER_CHAIN=cloudflare,openrouter,groq,google
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT=60
AI_MAX_RETRIES=2
AI_CACHE_ENABLED=true
AI_CACHE_DIR=./storage/ai_cache
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
OPENROUTER_API_KEY=
# Pick a current ":free" model from OpenRouter's Models page.
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
JWT_SECRET_KEY=CHANGE-ME-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
ALLOW_DEV_SEED_OWNER=true
STORAGE_BACKEND=local
STORAGE_DIR=./storage
LOG_LEVEL=INFO
