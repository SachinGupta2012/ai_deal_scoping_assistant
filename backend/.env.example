# Backend example — copy to .env and fill real secrets (never commit .env)
# AI modes:
#   Demo/test: USE_MOCK_AI=true, AI_PROVIDER=mock
#   Free live chain: USE_MOCK_AI=false, AI_PROVIDER=live_chain
#   Single provider first: USE_MOCK_AI=false, AI_PROVIDER=cloudflare|openrouter|groq|google
ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

USE_MOCK_AI=false
AI_PROVIDER=live_chain
AI_PROVIDER_CHAIN=cloudflare,openrouter,groq,google

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free



DB_HOST=
DB_PORT=12279
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT=60
AI_MAX_RETRIES=2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

JWT_SECRET_KEY=
JWT_ALGORITHM=  HS256
JWT_EXPIRE_MINUTES=120

# Storage (local dev; S3-compatible later)
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# AI caching (optional, for dev only)
AI_CACHE_ENABLED=true
AI_CACHE_DIR=./storage/ai_cache
 
# Observability
LOG_LEVEL=INFO