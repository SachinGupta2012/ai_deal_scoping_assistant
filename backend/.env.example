# Backend example — copy to .env and fill real secrets (never commit .env)
# Swap AI with .env only — no code change:
#   Google Gemini: AI_PROVIDER=google, AI_MODEL=gemini-3.8-flash, AI_API_KEY=<AI Studio key>
#   Groq / OpenRouter / Ollama: AI_PROVIDER=openai_compatible, AI_BASE_URL=<url>, AI_MODEL=<id>, AI_API_KEY=<key>
ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DB_HOST=
DB_PORT=12279
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
AI_PROVIDER=google
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT=60
AI_MAX_RETRIES=2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
JWT_SECRET_KEY=CHANGE-ME-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
STORAGE_BACKEND=local
STORAGE_DIR=./storage
LOG_LEVEL=INFO
